# Optional: OpenAI-compatible API for LLM-assisted classification/explanation.
# Leave unset to use the deterministic local fallback (recommended for offline demos).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Set to "local" to force local fallback even if a key is present.
LLM_MODE=auto
